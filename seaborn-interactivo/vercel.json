{
  "version": 2,
  "name": "spotify-visualization",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/output/(.*)",
      "dest": "/output/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
